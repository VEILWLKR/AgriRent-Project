# Express API port
PORT=3101

# SQLite database file. Use a persistent volume when hosting.
DATABASE_PATH=./data/agrirent.sqlite

# Demo accounts are seeded automatically outside production.
# Set to true only when you intentionally want the documented demo accounts in production.
SEED_DEMO_USERS=false

# Initial superadmin account. The account is created once on server startup.
# Use a unique password of at least 12 characters and keep these values secret.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Platform Administrator
